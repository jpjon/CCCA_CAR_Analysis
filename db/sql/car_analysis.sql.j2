-- CAR Analysis for year pair: {{ earlier_year }} → {{ later_year }}
-- This query finds parcels that:
-- 1. Intersected PRODES in the earlier year
-- 2. Changed geometry between years
-- 3. No longer intersect PRODES in the later year

-- 1. Find CAR parcels from {{ earlier_year }} intersecting PRODES, keep only the largest intersect from PRODES per cod_imovel
DROP TABLE IF EXISTS car_year_earlier_prodes_intersect;
CREATE TEMP TABLE car_year_earlier_prodes_intersect AS
WITH ranked AS (
    SELECT
        car.id,
        car.cod_imovel,
        car.ind_status,
        car.ind_tipo,
        car.cod_estado,
        car.geometry,
        car.year,
        ROW_NUMBER() OVER (PARTITION BY car.cod_imovel ORDER BY ST_Area(ST_Intersection(car.geometry, prodes.geometry)) DESC) AS rn
    FROM car_data AS car
    JOIN prodes
      ON ST_Intersects(car.geometry, prodes.geometry)
    WHERE car.year = {{ earlier_year }}
)
SELECT * FROM ranked WHERE rn = 1;

-- Create index on temp table for better join performance
CREATE INDEX idx_temp_cod_imovel ON car_year_earlier_prodes_intersect(cod_imovel);

-- 2. Join {{ later_year }} CAR data to earlier-year intersected parcels, and flag geometry changes
DROP TABLE IF EXISTS car_year_earlier_car_year_later_joined;
CREATE TEMP TABLE car_year_earlier_car_year_later_joined AS
SELECT
    e.id,
    e.cod_imovel,
    e.ind_status,
    e.ind_tipo,
    e.cod_estado,
    e.geometry,
    e.year,
    l.geometry AS geometry_later,
    NOT ST_Equals(e.geometry, l.geometry) AS geometry_changed
FROM car_year_earlier_prodes_intersect e
JOIN car_data l
  ON e.cod_imovel = l.cod_imovel
WHERE l.year = {{ later_year }};

-- 3. Keep only those with changed geometry
DROP TABLE IF EXISTS car_geom_changed;
CREATE TEMP TABLE car_geom_changed AS
SELECT *
FROM car_year_earlier_car_year_later_joined
WHERE geometry_changed = TRUE;

-- Create index for the anti-join
CREATE INDEX idx_geom_changed_cod_imovel ON car_geom_changed(cod_imovel);

-- 4. Find {{ later_year }} geometries that no longer intersect PRODES using anti-join
-- Step 1: Create the intersecting table (just IDs for efficiency)
DROP TABLE IF EXISTS car_intersects_prodes_later;
CREATE TEMP TABLE car_intersects_prodes_later AS
SELECT DISTINCT c.cod_imovel
FROM car_geom_changed c
JOIN prodes p ON ST_Intersects(c.geometry_later, p.geometry);

-- Step 2: Use anti-join to find parcels that no longer intersect
DROP TABLE IF EXISTS car_no_longer_intersects_prodes;
CREATE TEMP TABLE car_no_longer_intersects_prodes AS
SELECT 
    c.cod_imovel,
    c.ind_status,
    c.ind_tipo,
    c.cod_estado,
    c.geometry AS geometry_earlier,
    c.geometry_later
FROM car_geom_changed c
LEFT JOIN car_intersects_prodes_later ic ON c.cod_imovel = ic.cod_imovel
WHERE ic.cod_imovel IS NULL;

-- 5. Calculate distances and prepare final results
INSERT INTO car_changed_to_exclude_prodes (
    cod_imovel,
    year_earlier,
    year_later,
    ind_status,
    ind_tipo,
    cod_estado,
    geometry_earlier,
    geometry_later,
    centroid_earlier,
    centroid_later,
    geodesic_distance,
    distance_line
)
SELECT 
    cod_imovel,
    {{ earlier_year }} as year_earlier,
    {{ later_year }} as year_later,
    ind_status,
    ind_tipo,
    cod_estado,
    geometry_earlier,
    geometry_later,
    ST_Centroid(geometry_earlier) as centroid_earlier,
    ST_Centroid(geometry_later) as centroid_later,
    ST_Distance(
        ST_Centroid(geometry_earlier)::geography,
        ST_Centroid(geometry_later)::geography
    ) as geodesic_distance,
    ST_MakeLine(
        ST_Centroid(geometry_earlier), 
        ST_Centroid(geometry_later)
    ) as distance_line
FROM car_no_longer_intersects_prodes;

-- Clean up temp tables (optional, they'll be dropped at session end anyway)
DROP TABLE IF EXISTS car_year_earlier_prodes_intersect;
DROP TABLE IF EXISTS car_year_earlier_car_year_later_joined;
DROP TABLE IF EXISTS car_geom_changed;
DROP TABLE IF EXISTS car_intersects_prodes_later;
DROP TABLE IF EXISTS car_no_longer_intersects_prodes;